theorem
CategoryTheory.largeCurriedYonedaLemma.proof_2
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] {Y Z : Cᵒᵖ} (f : Y ⟶ Z),
  CategoryTheory.CategoryStruct.comp ((CategoryTheory.yoneda.op.comp CategoryTheory.coyoneda).map f)
      ((fun X =>
            CategoryTheory.NatIso.ofComponents (fun x => (CategoryTheory.yonedaEquiv.trans Equiv.ulift.symm).toIso) ⋯)
          Z).hom =
    CategoryTheory.CategoryStruct.comp
      ((fun X =>
            CategoryTheory.NatIso.ofComponents (fun x => (CategoryTheory.yonedaEquiv.trans Equiv.ulift.symm).toIso) ⋯)
          Y).hom
      (((CategoryTheory.evaluation Cᵒᵖ (Type u_2)).comp
            ((CategoryTheory.whiskeringRight (CategoryTheory.Functor Cᵒᵖ (Type u_2)) (Type u_2)
                  (Type (max u_1 u_2))).obj
              CategoryTheory.uliftFunctor.{u_1, u_2})).map
        f)
#[propext, Quot.sound]
---
theorem
CategoryTheory.coyonedaEquiv_naturality
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {X Y : C} {F : CategoryTheory.Functor C (Type v₁)}
  (f : CategoryTheory.coyoneda.obj (Opposite.op X) ⟶ F) (g : X ⟶ Y),
  F.map g (CategoryTheory.coyonedaEquiv f) =
    CategoryTheory.coyonedaEquiv (CategoryTheory.CategoryStruct.comp (CategoryTheory.coyoneda.map g.op) f)
#[propext, Quot.sound, sorryAx]
---
theorem
CategoryTheory.Yoneda.naturality
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {X Y : C}
  (α : CategoryTheory.yoneda.obj X ⟶ CategoryTheory.yoneda.obj Y) {Z Z' : C} (f : Z ⟶ Z') (h : Z' ⟶ X),
  CategoryTheory.CategoryStruct.comp f (α.app (Opposite.op Z') h) =
    α.app (Opposite.op Z) (CategoryTheory.CategoryStruct.comp f h)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Functor.CorepresentableBy.mk.sizeOf_spec
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {F : CategoryTheory.Functor C (Type v)} {X : C}
  [inst_1 : SizeOf C] (homEquiv : {Y : C} → (X ⟶ Y) ≃ F.obj Y)
  (homEquiv_comp :
    ∀ {Y Y' : C} (g : Y ⟶ Y') (f : X ⟶ Y), homEquiv (CategoryTheory.CategoryStruct.comp f g) = F.map g (homEquiv f)),
  sizeOf (CategoryTheory.Functor.CorepresentableBy.mk homEquiv homEquiv_comp) = 1
#[propext, Quot.sound]

---
theorem
CategoryTheory.yonedaEquiv_apply
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {X : C} {F : CategoryTheory.Functor Cᵒᵖ (Type v₁)}
  (f : CategoryTheory.yoneda.obj X ⟶ F),
  CategoryTheory.yonedaEquiv f = f.app (Opposite.op X) (CategoryTheory.CategoryStruct.id X)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Functor.FullyFaithful.homNatIsoMaxRight.proof_1
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] {D : Type u_4}
  [inst_1 : CategoryTheory.Category.{max u_2 u_3, u_4} D] {F : CategoryTheory.Functor C D} (hF : F.FullyFaithful)
  (X : C) {X_1 Y : Cᵒᵖ} (f : X_1 ⟶ Y),
  CategoryTheory.CategoryStruct.comp ((F.op.comp (CategoryTheory.yoneda.obj (F.obj X))).map f)
      ((fun Y => (hF.homEquiv.symm.trans Equiv.ulift.symm).toIso) Y).hom =
    CategoryTheory.CategoryStruct.comp ((fun Y => (hF.homEquiv.symm.trans Equiv.ulift.symm).toIso) X_1).hom
      (((CategoryTheory.yoneda.obj X).comp CategoryTheory.uliftFunctor.{u_3, u_2}).map f)
#[propext, Quot.sound]
---
theorem
CategoryTheory.instIsCorepresentableIdType
(CategoryTheory.Functor.id (Type v₁)).IsCorepresentable
#[propext, Quot.sound, Classical.choice]
---
theorem
CategoryTheory.Coyoneda.objOpOp_inv_app
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] (X : C) (X_1 : Cᵒᵖ)
  (a : (CategoryTheory.yoneda.obj X).obj X_1),
  (CategoryTheory.Coyoneda.objOpOp X).inv.app X_1 a = (CategoryTheory.opEquiv (Opposite.op X) X_1).symm a
#[propext, Quot.sound]
---

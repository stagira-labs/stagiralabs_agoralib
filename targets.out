theorem
CategoryTheory.coyoneda.proof_2
∀ {C : Type u_2} [inst : CategoryTheory.Category.{u_1, u_2} C] (X : Cᵒᵖ) {X_1 Y Z : C} (f : X_1 ⟶ Y) (g : Y ⟶ Z),
  { obj := fun Y => Opposite.unop X ⟶ Y, map := fun {X_2 Y} f g => CategoryTheory.CategoryStruct.comp g f }.map
      (CategoryTheory.CategoryStruct.comp f g) =
    CategoryTheory.CategoryStruct.comp
      ({ obj := fun Y => Opposite.unop X ⟶ Y, map := fun {X_2 Y} f g => CategoryTheory.CategoryStruct.comp g f }.map f)
      ({ obj := fun Y => Opposite.unop X ⟶ Y, map := fun {X_2 Y} f g => CategoryTheory.CategoryStruct.comp g f }.map g)
#[propext, Quot.sound]

---
theorem
CategoryTheory.coyonedaEquiv.proof_2
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] {X : C} {F : CategoryTheory.Functor C (Type u_2)}
  (η : CategoryTheory.coyoneda.obj (Opposite.op X) ⟶ F),
  (fun ξ => { app := fun x x_1 => F.map x_1 ξ, naturality := ⋯ })
      ((fun η => η.app X (CategoryTheory.CategoryStruct.id X)) η) =
    η
#[propext, Quot.sound]
---
theorem
CategoryTheory.Functor.RepresentableBy.ofIso.proof_1
∀ {C : Type u_2} [inst : CategoryTheory.Category.{u_1, u_2} C] {F F' : CategoryTheory.Functor Cᵒᵖ (Type u_3)} {Y : C}
  (e : F.RepresentableBy Y) (e' : F ≅ F') {X X' : C} (f : X ⟶ X') (g : X' ⟶ Y),
  (fun {X} => e.homEquiv.trans (e'.app (Opposite.op X)).toEquiv) (CategoryTheory.CategoryStruct.comp f g) =
    F'.map f.op ((fun {X} => e.homEquiv.trans (e'.app (Opposite.op X)).toEquiv) g)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Functor.representableByEquiv.proof_4
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] {F : CategoryTheory.Functor Cᵒᵖ (Type u_2)} {Y : C}
  (x : CategoryTheory.yoneda.obj Y ≅ F),
  (fun r => CategoryTheory.NatIso.ofComponents (fun x => r.homEquiv.toIso) ⋯)
      ((fun e => CategoryTheory.Functor.RepresentableBy.mk (fun {X} => (e.app (Opposite.op X)).toEquiv) ⋯) x) =
    (fun r => CategoryTheory.NatIso.ofComponents (fun x => r.homEquiv.toIso) ⋯)
      ((fun e => CategoryTheory.Functor.RepresentableBy.mk (fun {X} => (e.app (Opposite.op X)).toEquiv) ⋯) x)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Functor.CorepresentableBy.homEquiv_symm_comp
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {F : CategoryTheory.Functor C (Type v)} {X : C}
  (e : F.CorepresentableBy X) {Y Y' : C} (y : F.obj Y) (g : Y ⟶ Y'),
  CategoryTheory.CategoryStruct.comp (e.homEquiv.symm y) g = e.homEquiv.symm (F.map g y)
#[propext, Quot.sound]
---
theorem
_auxLemma.1
∀ {C : Type u} [inst : CategoryTheory.Category.{v, u} C] (F G : CategoryTheory.Functor C (Type w)) {X Y : C} (σ : F ⟶ G)
  (f : X ⟶ Y) (x : F.obj X), G.map f (σ.app X x) = σ.app Y (F.map f x)
#[propext, Quot.sound]

theorem
CategoryTheory.map_coyonedaEquiv
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {X Y : C} {F : CategoryTheory.Functor C (Type v₁)}
  (f : CategoryTheory.coyoneda.obj (Opposite.op X) ⟶ F) (g : X ⟶ Y),
  F.map g (CategoryTheory.coyonedaEquiv f) = f.app Y g
#[propext, Quot.sound, sorryAx]

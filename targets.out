---
theorem
CategoryTheory.Coyoneda.fullyFaithful.proof_2
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] {X Y : Cᵒᵖ} (f : X ⟶ Y),
  (CategoryTheory.CategoryStruct.comp f.unop (CategoryTheory.CategoryStruct.id (Opposite.unop X))).op = f
#[propext]
---
theorem
CategoryTheory.Functor.CorepresentableBy.homEquiv_comp
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {F : CategoryTheory.Functor C (Type v)} {X : C}
  (self : F.CorepresentableBy X) {Y Y' : C} (g : Y ⟶ Y') (f : X ⟶ Y),
  self.homEquiv (CategoryTheory.CategoryStruct.comp f g) = F.map g (self.homEquiv f)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Functor.IsRepresentable.has_representation
∀ {C : Type u₁} {inst : CategoryTheory.Category.{v₁, u₁} C} {F : CategoryTheory.Functor Cᵒᵖ (Type v)}
  [self : F.IsRepresentable], ∃ Y, Nonempty (F.RepresentableBy Y)
#[propext, Quot.sound]
---
theorem
CategoryTheory.yonedaEquiv.proof_1
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] {X : C} {F : CategoryTheory.Functor Cᵒᵖ (Type u_2)}
  (ξ : F.obj (Opposite.op X)) ⦃X_1 Y : Cᵒᵖ⦄ (f : X_1 ⟶ Y),
  CategoryTheory.CategoryStruct.comp ((CategoryTheory.yoneda.obj X).map f) ((fun x f => F.map (Quiver.Hom.op f) ξ) Y) =
    CategoryTheory.CategoryStruct.comp ((fun x f => F.map (Quiver.Hom.op f) ξ) X_1) (F.map f)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Functor.RepresentableBy.ext_iff
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {F : CategoryTheory.Functor Cᵒᵖ (Type v)} {Y : C}
  {e e' : F.RepresentableBy Y},
  e = e' ↔ e.homEquiv (CategoryTheory.CategoryStruct.id Y) = e'.homEquiv (CategoryTheory.CategoryStruct.id Y)
#[propext, Quot.sound]

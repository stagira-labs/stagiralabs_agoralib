theorem
CategoryTheory.yonedaPairingExt_iff
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {X : Cᵒᵖ × CategoryTheory.Functor Cᵒᵖ (Type v₁)}
  {x y : (CategoryTheory.yonedaPairing C).obj X}, x = y ↔ ∀ (Y : Cᵒᵖ), x.app Y = y.app Y

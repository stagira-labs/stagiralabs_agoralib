CategoryTheory.curriedYonedaLemma'.proof_2
∀ {C : Type u_1} [inst : CategoryTheory.SmallCategory C] {X Y : CategoryTheory.Functor Cᵒᵖ (Type u_1)} (f : X ⟶ Y),
  CategoryTheory.CategoryStruct.comp
      ((CategoryTheory.yoneda.comp
            ((CategoryTheory.whiskeringLeft Cᵒᵖ (CategoryTheory.Functor Cᵒᵖ (Type u_1))ᵒᵖ (Type u_1)).obj
              CategoryTheory.yoneda.op)).map
        f)
      ((fun F => CategoryTheory.NatIso.ofComponents (fun x => CategoryTheory.yonedaEquiv.toIso) ⋯) Y).hom =
    CategoryTheory.CategoryStruct.comp
      ((fun F => CategoryTheory.NatIso.ofComponents (fun x => CategoryTheory.yonedaEquiv.toIso) ⋯) X).hom
      ((CategoryTheory.Functor.id (CategoryTheory.Functor Cᵒᵖ (Type u_1))).map f)
#[propext, Quot.sound]

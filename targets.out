theorem
CategoryTheory.yonedaEquiv_comp
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {X : C} {F G : CategoryTheory.Functor Cᵒᵖ (Type v₁)}
  (α : CategoryTheory.yoneda.obj X ⟶ F) (β : F ⟶ G),
  CategoryTheory.yonedaEquiv (CategoryTheory.CategoryStruct.comp α β) =
    β.app (Opposite.op X) (CategoryTheory.yonedaEquiv α)

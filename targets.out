CategoryTheory.Functor.IsCorepresentable.recOn
{C : Type u₁} →
  [inst : CategoryTheory.Category.{v₁, u₁} C] →
    {F : CategoryTheory.Functor C (Type v)} →
      {motive : F.IsCorepresentable → Sort u} →
        (t : F.IsCorepresentable) →
          ((has_corepresentation : ∃ X, Nonempty (F.CorepresentableBy X)) → motive ⋯) → motive t

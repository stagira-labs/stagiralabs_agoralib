theorem
CategoryTheory.largeCurriedYonedaLemma.proof_1
∀ {C : Type u_2} [inst : CategoryTheory.Category.{u_1, u_2} C] (X : Cᵒᵖ) {Y Z : CategoryTheory.Functor Cᵒᵖ (Type u_1)}
  (f : Y ⟶ Z),
  CategoryTheory.CategoryStruct.comp (((CategoryTheory.yoneda.op.comp CategoryTheory.coyoneda).obj X).map f)
      ((fun x => (CategoryTheory.yonedaEquiv.trans Equiv.ulift.symm).toIso) Z).hom =
    CategoryTheory.CategoryStruct.comp ((fun x => (CategoryTheory.yonedaEquiv.trans Equiv.ulift.symm).toIso) Y).hom
      ((((CategoryTheory.evaluation Cᵒᵖ (Type u_1)).comp
                ((CategoryTheory.whiskeringRight (CategoryTheory.Functor Cᵒᵖ (Type u_1)) (Type u_1)
                      (Type (max u_2 u_1))).obj
                  CategoryTheory.uliftFunctor.{u_2, u_1})).obj
            X).map
        f)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Coyoneda.punitIso.proof_3
∀ {X Y : Type u_1} (f : X ⟶ Y),
  CategoryTheory.CategoryStruct.comp ((CategoryTheory.coyoneda.obj (Opposite.op PUnit.{u_1 + 1})).map f)
      ((fun X => { hom := fun f => f PUnit.unit, inv := fun x x_1 => x, hom_inv_id := ⋯, inv_hom_id := ⋯ }) Y).hom =
    CategoryTheory.CategoryStruct.comp
      ((fun X => { hom := fun f => f PUnit.unit, inv := fun x x_1 => x, hom_inv_id := ⋯, inv_hom_id := ⋯ }) X).hom
      ((CategoryTheory.Functor.id (Type u_1)).map f)
#[propext, Quot.sound]

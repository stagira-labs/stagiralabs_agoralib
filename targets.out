theorem
CategoryTheory.Yoneda.ext.proof_1
∀ {C : Type u_2} [inst : CategoryTheory.Category.{u_1, u_2} C] (X Y : C) (p : {Z : C} → (Z ⟶ X) → (Z ⟶ Y))
  (q : {Z : C} → (Z ⟶ Y) → (Z ⟶ X)),
  (∀ {Z : C} (f : Z ⟶ X), q (p f) = f) →
    ∀ (Z : Cᵒᵖ),
      CategoryTheory.CategoryStruct.comp p q = CategoryTheory.CategoryStruct.id ((CategoryTheory.yoneda.obj X).obj Z)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Functor.representableByEquiv.proof_1
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] {F : CategoryTheory.Functor Cᵒᵖ (Type u_2)} {Y : C}
  (r : F.RepresentableBy Y) {X X' : Cᵒᵖ} (f : X ⟶ X'),
  CategoryTheory.CategoryStruct.comp ((CategoryTheory.yoneda.obj Y).map f) ((fun x => r.homEquiv.toIso) X').hom =
    CategoryTheory.CategoryStruct.comp ((fun x => r.homEquiv.toIso) X).hom (F.map f)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Coyoneda.objOpOp.proof_1
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] (X : C) {X_1 Y : Cᵒᵖ} (f : X_1 ⟶ Y),
  CategoryTheory.CategoryStruct.comp ((CategoryTheory.coyoneda.obj (Opposite.op (Opposite.op X))).map f)
      ((fun x => (CategoryTheory.opEquiv (Opposite.unop (Opposite.op (Opposite.op X))) x).toIso) Y).hom =
    CategoryTheory.CategoryStruct.comp
      ((fun x => (CategoryTheory.opEquiv (Opposite.unop (Opposite.op (Opposite.op X))) x).toIso) X_1).hom
      ((CategoryTheory.yoneda.obj X).map f)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Functor.IsCorepresentable.has_corepresentation
∀ {C : Type u₁} {inst : CategoryTheory.Category.{v₁, u₁} C} {F : CategoryTheory.Functor C (Type v)}
  [self : F.IsCorepresentable], ∃ X, Nonempty (F.CorepresentableBy X)
#[propext, Quot.sound]
---
theorem
CategoryTheory.yoneda_obj_obj
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] (X : C) (Y : Cᵒᵖ),
  (CategoryTheory.yoneda.obj X).obj Y = (Opposite.unop Y ⟶ X)
#[propext, Quot.sound]
---
theorem
CategoryTheory.largeCurriedCoyonedaLemma.proof_2
∀ {C : Type u_2} [inst : CategoryTheory.Category.{u_1, u_2} C] {Y Z : C} (f : Y ⟶ Z),
  CategoryTheory.CategoryStruct.comp ((CategoryTheory.coyoneda.rightOp.comp CategoryTheory.coyoneda).map f)
      ((fun X =>
            CategoryTheory.NatIso.ofComponents (fun x => (CategoryTheory.coyonedaEquiv.trans Equiv.ulift.symm).toIso) ⋯)
          Z).hom =
    CategoryTheory.CategoryStruct.comp
      ((fun X =>
            CategoryTheory.NatIso.ofComponents (fun x => (CategoryTheory.coyonedaEquiv.trans Equiv.ulift.symm).toIso) ⋯)
          Y).hom
      (((CategoryTheory.evaluation C (Type u_1)).comp
            ((CategoryTheory.whiskeringRight (CategoryTheory.Functor C (Type u_1)) (Type u_1) (Type (max u_2 u_1))).obj
              CategoryTheory.uliftFunctor.{u_2, u_1})).map
        f)
#[propext, Quot.sound, sorryAx]

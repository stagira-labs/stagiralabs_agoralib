theorem
CategoryTheory.Functor.representableByEquiv.proof_2
∀ {C : Type u_2} [inst : CategoryTheory.Category.{u_1, u_2} C] {F : CategoryTheory.Functor Cᵒᵖ (Type u_1)} {Y : C}
  (e : CategoryTheory.yoneda.obj Y ≅ F) {X X' : C} (f : X ⟶ X') (g : X' ⟶ Y),
  CategoryTheory.CategoryStruct.comp ((CategoryTheory.yoneda.obj Y).map f.op) (e.hom.app (Opposite.op X)) g =
    CategoryTheory.CategoryStruct.comp (e.hom.app (Opposite.op X')) (F.map f.op) g
#[propext, Quot.sound]

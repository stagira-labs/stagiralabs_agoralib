theorem
CategoryTheory.largeCurriedCoyonedaLemma.proof_1
∀ {C : Type u_2} [inst : CategoryTheory.Category.{u_1, u_2} C] (X : C) {Y Z : CategoryTheory.Functor C (Type u_1)}
  (f : Y ⟶ Z),
  CategoryTheory.CategoryStruct.comp (((CategoryTheory.coyoneda.rightOp.comp CategoryTheory.coyoneda).obj X).map f)
      ((fun x => (CategoryTheory.coyonedaEquiv.trans Equiv.ulift.symm).toIso) Z).hom =
    CategoryTheory.CategoryStruct.comp ((fun x => (CategoryTheory.coyonedaEquiv.trans Equiv.ulift.symm).toIso) Y).hom
      ((((CategoryTheory.evaluation C (Type u_1)).comp
                ((CategoryTheory.whiskeringRight (CategoryTheory.Functor C (Type u_1)) (Type u_1)
                      (Type (max u_2 u_1))).obj
                  CategoryTheory.uliftFunctor.{u_2, u_1})).obj
            X).map
        f)

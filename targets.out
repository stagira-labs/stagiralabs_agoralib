CategoryTheory.isRepresentable_of_natIso
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] (F : CategoryTheory.Functor Cᵒᵖ (Type v₁))
  {G : CategoryTheory.Functor Cᵒᵖ (Type v₁)}, (F ≅ G) → ∀ [inst_1 : F.IsRepresentable], G.IsRepresentable

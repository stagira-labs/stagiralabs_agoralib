theorem
CategoryTheory.yonedaCompUliftFunctorEquiv.proof_1
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] (F : CategoryTheory.Functor Cᵒᵖ (Type (max u_2 u_3)))
  (X : C) (f : F.obj (Opposite.op X)) ⦃X_1 Y : Cᵒᵖ⦄ (f_1 : X_1 ⟶ Y),
  CategoryTheory.CategoryStruct.comp
      (((CategoryTheory.yoneda.obj X).comp CategoryTheory.uliftFunctor.{u_3, u_2}).map f_1)
      ((fun x x_1 => F.map (Quiver.Hom.op x_1.down) f) Y) =
    CategoryTheory.CategoryStruct.comp ((fun x x_1 => F.map (Quiver.Hom.op x_1.down) f) X_1) (F.map f_1)
#[propext, Quot.sound]

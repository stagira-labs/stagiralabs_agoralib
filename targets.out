theorem
CategoryTheory.yonedaPairingExt
∀ (C : Type u₁) [inst : CategoryTheory.Category.{v₁, u₁} C] {X : Cᵒᵖ × CategoryTheory.Functor Cᵒᵖ (Type v₁)}
  {x y : (CategoryTheory.yonedaPairing C).obj X}, (∀ (Y : Cᵒᵖ), x.app Y = y.app Y) → x = y
#[propext, Quot.sound]
---
theorem
CategoryTheory.Functor.corepresentableByEquiv.proof_2
∀ {C : Type u_2} [inst : CategoryTheory.Category.{u_1, u_2} C] {F : CategoryTheory.Functor C (Type u_1)} {X : C}
  (e : CategoryTheory.coyoneda.obj (Opposite.op X) ≅ F) {X_1 X' : C} (f : X_1 ⟶ X') (g : X ⟶ X_1),
  CategoryTheory.CategoryStruct.comp ((CategoryTheory.coyoneda.obj (Opposite.op X)).map f) (e.hom.app X') g =
    CategoryTheory.CategoryStruct.comp (e.hom.app X_1) (F.map f) g
#[propext, Quot.sound]

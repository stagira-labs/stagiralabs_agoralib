  (f : CategoryTheory.yoneda.obj X ⟶ CategoryTheory.yoneda.obj Y),
  CategoryTheory.yoneda.map
      ((fun {X Y} f => f.app (Opposite.op X) (CategoryTheory.CategoryStruct.id (Opposite.unop (Opposite.op X)))) f) =

---
theorem
CategoryTheory.coyonedaEquiv.proof_1
∀ {C : Type u_2} [inst : CategoryTheory.Category.{u_1, u_2} C] {X : C} {F : CategoryTheory.Functor C (Type u_1)}
  (ξ : F.obj X) ⦃X_1 Y : C⦄ (f : X_1 ⟶ Y),
  CategoryTheory.CategoryStruct.comp ((CategoryTheory.coyoneda.obj (Opposite.op X)).map f)
      ((fun x x_1 => F.map x_1 ξ) Y) =
    CategoryTheory.CategoryStruct.comp ((fun x x_1 => F.map x_1 ξ) X_1) (F.map f)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Coyoneda.punitIso.proof_1
∀ (X : Type u_1),
  (CategoryTheory.CategoryStruct.comp (fun f => f PUnit.unit) fun x x_1 => x) =
    CategoryTheory.CategoryStruct.id ((CategoryTheory.coyoneda.obj (Opposite.op PUnit.{u_1 + 1})).obj X)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Functor.CorepresentableBy.mk.inj
∀ {C : Type u₁} {inst : CategoryTheory.Category.{v₁, u₁} C} {F : CategoryTheory.Functor C (Type v)} {X : C}
  {homEquiv : {Y : C} → (X ⟶ Y) ≃ F.obj Y}
  {homEquiv_comp :
    ∀ {Y Y' : C} (g : Y ⟶ Y') (f : X ⟶ Y), homEquiv (CategoryTheory.CategoryStruct.comp f g) = F.map g (homEquiv f)}
  {homEquiv_1 : {Y : C} → (X ⟶ Y) ≃ F.obj Y}
  {homEquiv_comp_1 :
    ∀ {Y Y' : C} (g : Y ⟶ Y') (f : X ⟶ Y),
      homEquiv_1 (CategoryTheory.CategoryStruct.comp f g) = F.map g (homEquiv_1 f)},
  CategoryTheory.Functor.CorepresentableBy.mk homEquiv homEquiv_comp =
      CategoryTheory.Functor.CorepresentableBy.mk homEquiv_1 homEquiv_comp_1 →
    homEquiv = homEquiv_1
#[propext, Quot.sound]
---
theorem
CategoryTheory.curriedYonedaLemma.proof_2
∀ {C : Type u_1} [inst : CategoryTheory.SmallCategory C] {X Y : Cᵒᵖ} (f : X ⟶ Y),
  CategoryTheory.CategoryStruct.comp ((CategoryTheory.yoneda.op.comp CategoryTheory.coyoneda).map f)
      ((fun X => CategoryTheory.NatIso.ofComponents (fun x => CategoryTheory.yonedaEquiv.toIso) ⋯) Y).hom =
    CategoryTheory.CategoryStruct.comp
      ((fun X => CategoryTheory.NatIso.ofComponents (fun x => CategoryTheory.yonedaEquiv.toIso) ⋯) X).hom
      ((CategoryTheory.evaluation Cᵒᵖ (Type u_1)).map f)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Yoneda.fullyFaithful.proof_1
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] {X Y : C}
  (f : CategoryTheory.yoneda.obj X ⟶ CategoryTheory.yoneda.obj Y),
  CategoryTheory.yoneda.map
      ((fun {X Y} f => f.app (Opposite.op X) (CategoryTheory.CategoryStruct.id (Opposite.unop (Opposite.op X)))) f) =
    f
#[propext, Quot.sound]

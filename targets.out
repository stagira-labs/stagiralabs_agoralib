---
theorem
CategoryTheory.coyoneda_map_app
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {X Y : Cᵒᵖ} (f : X ⟶ Y) (x : C)
  (g :
    ((fun X =>
            { obj := fun Y => Opposite.unop X ⟶ Y, map := fun {X_1 Y} f g => CategoryTheory.CategoryStruct.comp g f,
              map_id := ⋯, map_comp := ⋯ })
          X).obj
      x),
  (CategoryTheory.coyoneda.map f).app x g = CategoryTheory.CategoryStruct.comp f.unop g
#[propext, Quot.sound]
---
theorem
CategoryTheory.yonedaMap.proof_1
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] {D : Type u_3}
  [inst_1 : CategoryTheory.Category.{u_2, u_3} D] (F : CategoryTheory.Functor C D) (X : C) ⦃X_1 Y : Cᵒᵖ⦄ (f : X_1 ⟶ Y),
  CategoryTheory.CategoryStruct.comp ((CategoryTheory.yoneda.obj X).map f) ((fun x f => F.map f) Y) =
    CategoryTheory.CategoryStruct.comp ((fun x f => F.map f) X_1)
      ((F.op.comp (CategoryTheory.yoneda.obj (F.obj X))).map f)
#[propext, Quot.sound]

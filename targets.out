CategoryTheory.coyonedaCompUliftFunctorEquiv.proof_2
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] (F : CategoryTheory.Functor C (Type (max u_2 u_3)))
  (X : Cᵒᵖ) (φ : (CategoryTheory.coyoneda.obj X).comp CategoryTheory.uliftFunctor.{u_3, u_2} ⟶ F),
  (fun f => { app := fun x x_1 => F.map x_1.down f, naturality := ⋯ })
      ((fun φ => φ.app (Opposite.unop X) { down := CategoryTheory.CategoryStruct.id (Opposite.unop X) }) φ) =
    φ

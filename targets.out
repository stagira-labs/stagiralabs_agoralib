theorem
CategoryTheory.coyonedaEquiv.proof_1
∀ {C : Type u_2} [inst : CategoryTheory.Category.{u_1, u_2} C] {X : C} {F : CategoryTheory.Functor C (Type u_1)}
  (ξ : F.obj X) ⦃X_1 Y : C⦄ (f : X_1 ⟶ Y),
  CategoryTheory.CategoryStruct.comp ((CategoryTheory.coyoneda.obj (Opposite.op X)).map f)
      ((fun x x_1 => F.map x_1 ξ) Y) =
    CategoryTheory.CategoryStruct.comp ((fun x x_1 => F.map x_1 ξ) X_1) (F.map f)
#[propext, Quot.sound]

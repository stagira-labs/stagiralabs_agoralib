            { obj := fun Y => Opposite.unop X ⟶ Y, map := fun {X_1 Y} f g => CategoryTheory.CategoryStruct.comp g f,
              map_id := ⋯, map_comp := ⋯ },
          map := fun {X Y} f => { app := fun x g => CategoryTheory.CategoryStruct.comp f.unop g, naturality := ⋯ } }.map
      (CategoryTheory.CategoryStruct.comp f g) =
    CategoryTheory.CategoryStruct.comp
      ({
            obj := fun X =>
              { obj := fun Y => Opposite.unop X ⟶ Y, map := fun {X_1 Y} f g => CategoryTheory.CategoryStruct.comp g f,
                map_id := ⋯, map_comp := ⋯ },
            map := fun {X Y} f =>
              { app := fun x g => CategoryTheory.CategoryStruct.comp f.unop g, naturality := ⋯ } }.map
        f)
      ({
            obj := fun X =>
              { obj := fun Y => Opposite.unop X ⟶ Y, map := fun {X_1 Y} f g => CategoryTheory.CategoryStruct.comp g f,
                map_id := ⋯, map_comp := ⋯ },
            map := fun {X Y} f =>
              { app := fun x g => CategoryTheory.CategoryStruct.comp f.unop g, naturality := ⋯ } }.map

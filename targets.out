theorem
CategoryTheory.yoneda.proof_2
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] (X : C) {X_1 Y Z : Cᵒᵖ} (f : X_1 ⟶ Y) (g : Y ⟶ Z),
  { obj := fun Y => Opposite.unop Y ⟶ X, map := fun {X_2 Y} f g => CategoryTheory.CategoryStruct.comp f.unop g }.map
      (CategoryTheory.CategoryStruct.comp f g) =
    CategoryTheory.CategoryStruct.comp
      ({ obj := fun Y => Opposite.unop Y ⟶ X,
            map := fun {X_2 Y} f g => CategoryTheory.CategoryStruct.comp f.unop g }.map
        f)
      ({ obj := fun Y => Opposite.unop Y ⟶ X,
            map := fun {X_2 Y} f g => CategoryTheory.CategoryStruct.comp f.unop g }.map
        g)
#[propext, Quot.sound]

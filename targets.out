theorem
CategoryTheory.curriedCoyonedaLemma.proof_1
∀ {C : Type u_1} [inst : CategoryTheory.SmallCategory C] (X : C) {X_1 Y : CategoryTheory.Functor C (Type u_1)}
  (f : X_1 ⟶ Y),
  CategoryTheory.CategoryStruct.comp (((CategoryTheory.coyoneda.rightOp.comp CategoryTheory.coyoneda).obj X).map f)
      ((fun x => CategoryTheory.coyonedaEquiv.toIso) Y).hom =
    CategoryTheory.CategoryStruct.comp ((fun x => CategoryTheory.coyonedaEquiv.toIso) X_1).hom
      (((CategoryTheory.evaluation C (Type u_1)).obj X).map f)
#[propext, Quot.sound]
---
theorem
CategoryTheory.yonedaLemma.proof_1
∀ (C : Type u_1) [inst : CategoryTheory.Category.{u_2, u_1} C] {h : Cᵒᵖ × CategoryTheory.Functor Cᵒᵖ (Type u_2)}
  {Y : Cᵒᵖ × CategoryTheory.Functor Cᵒᵖ (Type u_2)} (f : h ⟶ Y),
  CategoryTheory.CategoryStruct.comp ((CategoryTheory.yonedaPairing C).map f)
      ((fun x => (CategoryTheory.yonedaEquiv.trans Equiv.ulift.symm).toIso) Y).hom =
    CategoryTheory.CategoryStruct.comp ((fun x => (CategoryTheory.yonedaEquiv.trans Equiv.ulift.symm).toIso) h).hom
      ((CategoryTheory.yonedaEvaluation C).map f)
#[propext, Quot.sound]
---
theorem
CategoryTheory.yoneda.proof_1
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] (X : C) (X_1 : Cᵒᵖ),
  { obj := fun Y => Opposite.unop Y ⟶ X, map := fun {X_2 Y} f g => CategoryTheory.CategoryStruct.comp f.unop g }.map
      (CategoryTheory.CategoryStruct.id X_1) =
    CategoryTheory.CategoryStruct.id
      ({ obj := fun Y => Opposite.unop Y ⟶ X,
            map := fun {X_2 Y} f g => CategoryTheory.CategoryStruct.comp f.unop g }.obj
        X_1)
#[propext, Quot.sound]

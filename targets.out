theorem
CategoryTheory.coyonedaEquiv_apply
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {X : C} {F : CategoryTheory.Functor C (Type v₁)}
  (f : CategoryTheory.coyoneda.obj (Opposite.op X) ⟶ F),
  CategoryTheory.coyonedaEquiv f = f.app X (CategoryTheory.CategoryStruct.id X)

theorem
CategoryTheory.coyoneda.proof_4
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] (X : Cᵒᵖ),
  {
          obj := fun X =>
            { obj := fun Y => Opposite.unop X ⟶ Y, map := fun {X_1 Y} f g => CategoryTheory.CategoryStruct.comp g f,
              map_id := ⋯, map_comp := ⋯ },
          map := fun {X Y} f => { app := fun x g => CategoryTheory.CategoryStruct.comp f.unop g, naturality := ⋯ } }.map
      (CategoryTheory.CategoryStruct.id X) =
    CategoryTheory.CategoryStruct.id
      ({
            obj := fun X =>
              { obj := fun Y => Opposite.unop X ⟶ Y, map := fun {X_1 Y} f g => CategoryTheory.CategoryStruct.comp g f,
                map_id := ⋯, map_comp := ⋯ },
            map := fun {X Y} f =>
              { app := fun x g => CategoryTheory.CategoryStruct.comp f.unop g, naturality := ⋯ } }.obj
        X)
#[propext, Quot.sound]

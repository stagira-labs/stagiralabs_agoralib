theorem
CategoryTheory.curriedCoyonedaLemma.proof_2
∀ {C : Type u_1} [inst : CategoryTheory.SmallCategory C] {X Y : C} (f : X ⟶ Y),
  CategoryTheory.CategoryStruct.comp ((CategoryTheory.coyoneda.rightOp.comp CategoryTheory.coyoneda).map f)
      ((fun X => CategoryTheory.NatIso.ofComponents (fun x => CategoryTheory.coyonedaEquiv.toIso) ⋯) Y).hom =
    CategoryTheory.CategoryStruct.comp
      ((fun X => CategoryTheory.NatIso.ofComponents (fun x => CategoryTheory.coyonedaEquiv.toIso) ⋯) X).hom
      ((CategoryTheory.evaluation C (Type u_1)).map f)

---
theorem
CategoryTheory.yonedaMap_app_apply
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {D : Type u_1}
  [inst_1 : CategoryTheory.Category.{v₁, u_1} D] (F : CategoryTheory.Functor C D) {Y : C} {X : Cᵒᵖ}
  (f : Opposite.unop X ⟶ Y), (CategoryTheory.yonedaMap F Y).app X f = F.map f
#[propext, Quot.sound]
---
theorem
CategoryTheory.Coyoneda.naturality
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {X Y : Cᵒᵖ}
  (α : CategoryTheory.coyoneda.obj X ⟶ CategoryTheory.coyoneda.obj Y) {Z Z' : C} (f : Z' ⟶ Z)
  (h : Opposite.unop X ⟶ Z'),
  CategoryTheory.CategoryStruct.comp (α.app Z' h) f = α.app Z (CategoryTheory.CategoryStruct.comp h f)
#[propext, Quot.sound]
---
theorem
CategoryTheory.hom_ext_yoneda
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {P Q : CategoryTheory.Functor Cᵒᵖ (Type v₁)} {f g : P ⟶ Q},
  (∀ (X : C) (p : CategoryTheory.yoneda.obj X ⟶ P),
      CategoryTheory.CategoryStruct.comp p f = CategoryTheory.CategoryStruct.comp p g) →
    f = g
#[propext, Quot.sound]
---
theorem
CategoryTheory.coyoneda.proof_1
∀ {C : Type u_2} [inst : CategoryTheory.Category.{u_1, u_2} C] (X : Cᵒᵖ) (X_1 : C),
  { obj := fun Y => Opposite.unop X ⟶ Y, map := fun {X_2 Y} f g => CategoryTheory.CategoryStruct.comp g f }.map
      (CategoryTheory.CategoryStruct.id X_1) =
    CategoryTheory.CategoryStruct.id
      ({ obj := fun Y => Opposite.unop X ⟶ Y, map := fun {X_2 Y} f g => CategoryTheory.CategoryStruct.comp g f }.obj
        X_1)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Coyoneda.coyoneda_faithful
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C], CategoryTheory.coyoneda.Faithful
#[propext, Quot.sound]

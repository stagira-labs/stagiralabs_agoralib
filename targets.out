def
CategoryTheory.Functor.CorepresentableBy.casesOn
{C : Type u₁} →
  [inst : CategoryTheory.Category.{v₁, u₁} C] →
    {F : CategoryTheory.Functor C (Type v)} →
      {X : C} →
        {motive : F.CorepresentableBy X → Sort u} →
          (t : F.CorepresentableBy X) →
            ((homEquiv : {Y : C} → (X ⟶ Y) ≃ F.obj Y) →
                (homEquiv_comp :

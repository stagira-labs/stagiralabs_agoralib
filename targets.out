---
theorem
CategoryTheory.Yoneda.fullyFaithful_preimage
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {X Y : C}
  (f : CategoryTheory.yoneda.obj X ⟶ CategoryTheory.yoneda.obj Y),
  CategoryTheory.Yoneda.fullyFaithful.preimage f = f.app (Opposite.op X) (CategoryTheory.CategoryStruct.id X)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Functor.reprW_hom_app
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] (F : CategoryTheory.Functor Cᵒᵖ (Type v₁))
  [inst_1 : F.IsRepresentable] (X : Cᵒᵖ) (f : Opposite.unop X ⟶ F.reprX), F.reprW.hom.app X f = F.map f.op F.reprx
#[propext, Quot.sound, Classical.choice]

---
theorem
CategoryTheory.Functor.RepresentableBy.mk.sizeOf_spec
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {F : CategoryTheory.Functor Cᵒᵖ (Type v)} {Y : C}
  [inst_1 : SizeOf C] (homEquiv : {X : C} → (X ⟶ Y) ≃ F.obj (Opposite.op X))
  (homEquiv_comp :
    ∀ {X X' : C} (f : X ⟶ X') (g : X' ⟶ Y),
      homEquiv (CategoryTheory.CategoryStruct.comp f g) = F.map f.op (homEquiv g)),
  sizeOf (CategoryTheory.Functor.RepresentableBy.mk homEquiv homEquiv_comp) = 1
#[propext, Quot.sound]

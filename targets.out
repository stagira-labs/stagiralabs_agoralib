theorem
CategoryTheory.Functor.RepresentableBy.mk.injEq
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {F : CategoryTheory.Functor Cᵒᵖ (Type v)} {Y : C}
  (homEquiv : {X : C} → (X ⟶ Y) ≃ F.obj (Opposite.op X))
  (homEquiv_comp :
    ∀ {X X' : C} (f : X ⟶ X') (g : X' ⟶ Y), homEquiv (CategoryTheory.CategoryStruct.comp f g) = F.map f.op (homEquiv g))
  (homEquiv_1 : {X : C} → (X ⟶ Y) ≃ F.obj (Opposite.op X))
  (homEquiv_comp_1 :
    ∀ {X X' : C} (f : X ⟶ X') (g : X' ⟶ Y),
      homEquiv_1 (CategoryTheory.CategoryStruct.comp f g) = F.map f.op (homEquiv_1 g)),
  (CategoryTheory.Functor.RepresentableBy.mk homEquiv homEquiv_comp =
      CategoryTheory.Functor.RepresentableBy.mk homEquiv_1 homEquiv_comp_1) =
    (homEquiv = homEquiv_1)
#[propext, Quot.sound]
---
theorem
CategoryTheory.yonedaEvaluation_map_down
∀ (C : Type u₁) [inst : CategoryTheory.Category.{v₁, u₁} C] (P Q : Cᵒᵖ × CategoryTheory.Functor Cᵒᵖ (Type v₁))
  (α : P ⟶ Q) (x : (CategoryTheory.yonedaEvaluation C).obj P),
  ((CategoryTheory.yonedaEvaluation C).map α x).down = α.2.app Q.1 (P.2.map α.1 x.down)
#[propext, Quot.sound]
---
theorem
CategoryTheory.curriedCoyonedaLemma'.proof_1
∀ {C : Type u_1} [inst : CategoryTheory.SmallCategory C] (F : CategoryTheory.Functor C (Type u_1)) {X Y : C}
  (f : X ⟶ Y),
  CategoryTheory.CategoryStruct.comp
      (((CategoryTheory.yoneda.comp
                ((CategoryTheory.whiskeringLeft C (CategoryTheory.Functor C (Type u_1))ᵒᵖ (Type u_1)).obj
                  CategoryTheory.coyoneda.rightOp)).obj
            F).map
        f)
      ((fun x => CategoryTheory.coyonedaEquiv.toIso) Y).hom =
    CategoryTheory.CategoryStruct.comp ((fun x => CategoryTheory.coyonedaEquiv.toIso) X).hom
      (((CategoryTheory.Functor.id (CategoryTheory.Functor C (Type u_1))).obj F).map f)
#[propext, Quot.sound]

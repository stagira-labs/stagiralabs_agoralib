theorem
CategoryTheory.Functor.CorepresentableBy.isCorepresentable
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {F : CategoryTheory.Functor C (Type v)} {X : C},
  F.CorepresentableBy X → F.IsCorepresentable
#[propext, Quot.sound]
---
theorem
CategoryTheory.yonedaPairing_map
∀ (C : Type u₁) [inst : CategoryTheory.Category.{v₁, u₁} C] (P Q : Cᵒᵖ × CategoryTheory.Functor Cᵒᵖ (Type v₁))
  (α : P ⟶ Q) (β : (CategoryTheory.yonedaPairing C).obj P),
  (CategoryTheory.yonedaPairing C).map α β =
    CategoryTheory.CategoryStruct.comp (CategoryTheory.yoneda.map α.1.unop) (CategoryTheory.CategoryStruct.comp β α.2)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Functor.CorepresentableBy.mk.injEq
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {F : CategoryTheory.Functor C (Type v)} {X : C}
  (homEquiv : {Y : C} → (X ⟶ Y) ≃ F.obj Y)
  (homEquiv_comp :
    ∀ {Y Y' : C} (g : Y ⟶ Y') (f : X ⟶ Y), homEquiv (CategoryTheory.CategoryStruct.comp f g) = F.map g (homEquiv f))
  (homEquiv_1 : {Y : C} → (X ⟶ Y) ≃ F.obj Y)
  (homEquiv_comp_1 :
    ∀ {Y Y' : C} (g : Y ⟶ Y') (f : X ⟶ Y),
      homEquiv_1 (CategoryTheory.CategoryStruct.comp f g) = F.map g (homEquiv_1 f)),
  (CategoryTheory.Functor.CorepresentableBy.mk homEquiv homEquiv_comp =
      CategoryTheory.Functor.CorepresentableBy.mk homEquiv_1 homEquiv_comp_1) =
    (homEquiv = homEquiv_1)
#[propext, Quot.sound]
---
theorem
CategoryTheory.coyonedaEquiv_symm_map
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {X Y : C} (f : X ⟶ Y)
  {F : CategoryTheory.Functor C (Type v₁)} (t : F.obj X),
  CategoryTheory.coyonedaEquiv.symm (F.map f t) =
    CategoryTheory.CategoryStruct.comp (CategoryTheory.coyoneda.map f.op) (CategoryTheory.coyonedaEquiv.symm t)
#[propext, Quot.sound, sorryAx]
---
theorem
CategoryTheory.yoneda.proof_5
∀ {C : Type u_2} [inst : CategoryTheory.Category.{u_1, u_2} C] {X Y Z : C} (f : X ⟶ Y) (g : Y ⟶ Z),
  {
          obj := fun X =>
            { obj := fun Y => Opposite.unop Y ⟶ X,
              map := fun {X_1 Y} f g => CategoryTheory.CategoryStruct.comp f.unop g, map_id := ⋯, map_comp := ⋯ },
          map := fun {X Y} f => { app := fun x g => CategoryTheory.CategoryStruct.comp g f, naturality := ⋯ } }.map
      (CategoryTheory.CategoryStruct.comp f g) =
    CategoryTheory.CategoryStruct.comp
      ({
            obj := fun X =>
              { obj := fun Y => Opposite.unop Y ⟶ X,
                map := fun {X_1 Y} f g => CategoryTheory.CategoryStruct.comp f.unop g, map_id := ⋯, map_comp := ⋯ },
            map := fun {X Y} f => { app := fun x g => CategoryTheory.CategoryStruct.comp g f, naturality := ⋯ } }.map
        f)
      ({
            obj := fun X =>
              { obj := fun Y => Opposite.unop Y ⟶ X,
                map := fun {X_1 Y} f g => CategoryTheory.CategoryStruct.comp f.unop g, map_id := ⋯, map_comp := ⋯ },
            map := fun {X Y} f => { app := fun x g => CategoryTheory.CategoryStruct.comp g f, naturality := ⋯ } }.map
        g)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Functor.corepresentableByEquiv.proof_1
∀ {C : Type u_2} [inst : CategoryTheory.Category.{u_1, u_2} C] {F : CategoryTheory.Functor C (Type u_1)} {X : C}
  (r : F.CorepresentableBy X) {X_1 X' : C} (f : X_1 ⟶ X'),
  CategoryTheory.CategoryStruct.comp ((CategoryTheory.coyoneda.obj (Opposite.op X)).map f)
      ((fun x => r.homEquiv.toIso) X').hom =
    CategoryTheory.CategoryStruct.comp ((fun x => r.homEquiv.toIso) X_1).hom (F.map f)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Functor.FullyFaithful.homNatIso_hom_app_down
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {D : Type u₂} [inst_1 : CategoryTheory.Category.{v₂, u₂} D]
  {F : CategoryTheory.Functor C D} (hF : F.FullyFaithful) (X : C) (X_1 : Cᵒᵖ)
  (a : (F.op.comp ((CategoryTheory.yoneda.obj (F.obj X)).comp CategoryTheory.uliftFunctor.{v₁, v₂})).obj X_1),
  ((hF.homNatIso X).hom.app X_1 a).down = hF.preimage a.down
#[propext, Quot.sound]

theorem
CategoryTheory.Functor.instIsCorepresentableObjOppositeTypeCoyoneda
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {X : Cᵒᵖ}, (CategoryTheory.coyoneda.obj X).IsCorepresentable

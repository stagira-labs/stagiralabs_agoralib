  (e : F.CorepresentableBy X) (e' : F ≅ F') {Y Y' : C} (g : Y ⟶ Y') (f : X ⟶ Y),
  (fun {X_1} => e.homEquiv.trans (e'.app X_1).toEquiv) (CategoryTheory.CategoryStruct.comp f g) =
    F'.map g ((fun {X_1} => e.homEquiv.trans (e'.app X_1).toEquiv) f)

---
theorem
CategoryTheory.yonedaEquiv.proof_2
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] {X : C} {F : CategoryTheory.Functor Cᵒᵖ (Type u_2)}
  (η : CategoryTheory.yoneda.obj X ⟶ F),
  (fun ξ => { app := fun x f => F.map (Quiver.Hom.op f) ξ, naturality := ⋯ })
      ((fun η => η.app (Opposite.op X) (CategoryTheory.CategoryStruct.id X)) η) =
    η
#[propext, Quot.sound]
---
theorem
CategoryTheory.Coyoneda.fullyFaithful.proof_1
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] {X Y : Cᵒᵖ}
  (f : CategoryTheory.coyoneda.obj X ⟶ CategoryTheory.coyoneda.obj Y),
  CategoryTheory.coyoneda.map
      ((fun {X Y} f => Quiver.Hom.op (f.app (Opposite.unop X) (CategoryTheory.CategoryStruct.id (Opposite.unop X))))
        f) =
    f
#[propext, Quot.sound]

---
theorem
CategoryTheory.Functor.CorepresentableBy.ext
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {F : CategoryTheory.Functor C (Type v)} {X : C}
  {e e' : F.CorepresentableBy X},
  e.homEquiv (CategoryTheory.CategoryStruct.id X) = e'.homEquiv (CategoryTheory.CategoryStruct.id X) → e = e'
#[propext, Quot.sound]
---
theorem
CategoryTheory.Functor.FullyFaithful.homNatIsoMaxRight_hom_app_down
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {D : Type u₂}
  [inst_1 : CategoryTheory.Category.{max v₁ v₂, u₂} D] {F : CategoryTheory.Functor C D} (hF : F.FullyFaithful) (X : C)
  (X_1 : Cᵒᵖ) (a : (F.op.comp (CategoryTheory.yoneda.obj (F.obj X))).obj X_1),
  ((hF.homNatIsoMaxRight X).hom.app X_1 a).down = hF.preimage a
#[propext, Quot.sound]

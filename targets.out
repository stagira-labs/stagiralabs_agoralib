theorem
CategoryTheory.Functor.RepresentableBy.comp_homEquiv_symm
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {F : CategoryTheory.Functor Cᵒᵖ (Type v)} {Y : C}
  (e : F.RepresentableBy Y) {X X' : C} (x : F.obj (Opposite.op X')) (f : X ⟶ X'),
  CategoryTheory.CategoryStruct.comp f (e.homEquiv.symm x) = e.homEquiv.symm (F.map f.op x)
#[propext, Quot.sound]

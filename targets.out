∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {X : C} {F : CategoryTheory.Functor C (Type v₁)},
  CategoryTheory.coyonedaEquiv =
    { toFun := fun η => η.app X (CategoryTheory.CategoryStruct.id X),
      invFun := fun ξ => { app := fun x x_1 => F.map x_1 ξ, naturality := ⋯ }, left_inv := ⋯, right_inv := ⋯ }
#[propext, Quot.sound]

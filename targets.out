---
theorem
CategoryTheory.yoneda_map_app
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {X Y : C} (f : X ⟶ Y) (x : Cᵒᵖ)
  (g :
    ((fun X =>
            { obj := fun Y => Opposite.unop Y ⟶ X,
              map := fun {X_1 Y} f g => CategoryTheory.CategoryStruct.comp f.unop g, map_id := ⋯, map_comp := ⋯ })
          X).obj
      x),
  (CategoryTheory.yoneda.map f).app x g = CategoryTheory.CategoryStruct.comp g f
#[propext, Quot.sound]
---
theorem
CategoryTheory.coyonedaLemma.proof_1
∀ (C : Type u_1) [inst : CategoryTheory.Category.{u_2, u_1} C] {h : C × CategoryTheory.Functor C (Type u_2)}
  {Y : C × CategoryTheory.Functor C (Type u_2)} (f : h ⟶ Y),
  CategoryTheory.CategoryStruct.comp ((CategoryTheory.coyonedaPairing C).map f)
      ((fun x => (CategoryTheory.coyonedaEquiv.trans Equiv.ulift.symm).toIso) Y).hom =
    CategoryTheory.CategoryStruct.comp ((fun x => (CategoryTheory.coyonedaEquiv.trans Equiv.ulift.symm).toIso) h).hom
      ((CategoryTheory.coyonedaEvaluation C).map f)
#[propext, Quot.sound]

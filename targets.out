:= fun {C : Type.{u₁}} [inst._@._hyg.2855 : CategoryTheory.Category.{v₁, u₁} C] {F : CategoryTheory.Functor.{v₁, v, u₁, succ v} C inst._@._hyg.2855 Type.{v} CategoryTheory.types.{v}} {motive : (CategoryTheory.Functor.IsCorepresentable.{v, v₁, u₁} C inst._@._hyg.2855 F) -> Sort.{u}} (t : CategoryTheory.Functor.IsCorepresentable.{v, v₁, u₁} C inst._@._hyg.2855 F) (mk : forall (has_corepresentation : Exists.{succ u₁} C (fun (X : C) => Nonempty.{max (max (succ u₁) (succ v)) (succ v₁)} (CategoryTheory.Functor.CorepresentableBy.{v, v₁, u₁} C inst._@._hyg.2855 F X))), motive (CategoryTheory.Functor.IsCorepresentable.mk.{v, v₁, u₁} C inst._@._hyg.2855 F has_corepresentation)) => CategoryTheory.Functor.IsCorepresentable.rec.{u, v, v₁, u₁} C inst._@._hyg.2855 F motive mk t

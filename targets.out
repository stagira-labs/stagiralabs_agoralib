  (X : C) (φ : (CategoryTheory.yoneda.obj X).comp CategoryTheory.uliftFunctor.{u_3, u_2} ⟶ F),
  (fun f => { app := fun x x_1 => F.map (Quiver.Hom.op x_1.down) f, naturality := ⋯ })
      ((fun φ => φ.app (Opposite.op X) { down := CategoryTheory.CategoryStruct.id (Opposite.unop (Opposite.op X)) })
        φ) =
    φ

theorem
CategoryTheory.yoneda.proof_3
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] {X Y : C} (f : X ⟶ Y) ⦃X_1 Y_1 : Cᵒᵖ⦄ (f_1 : X_1 ⟶ Y_1),
  CategoryTheory.CategoryStruct.comp
      (((fun X =>
              { obj := fun Y => Opposite.unop Y ⟶ X,
                map := fun {X_2 Y} f g => CategoryTheory.CategoryStruct.comp f.unop g, map_id := ⋯, map_comp := ⋯ })
            X).map
        f_1)
      ((fun x g => CategoryTheory.CategoryStruct.comp g f) Y_1) =
    CategoryTheory.CategoryStruct.comp ((fun x g => CategoryTheory.CategoryStruct.comp g f) X_1)
      (((fun X =>
              { obj := fun Y => Opposite.unop Y ⟶ X,
                map := fun {X_2 Y} f g => CategoryTheory.CategoryStruct.comp f.unop g, map_id := ⋯, map_comp := ⋯ })
            Y).map
        f_1)
#[propext, Quot.sound]

theorem
CategoryTheory.Functor.corepresentableByEquiv.proof_4
∀ {C : Type u_1} [inst : CategoryTheory.Category.{u_2, u_1} C] {F : CategoryTheory.Functor C (Type u_2)} {X : C}
  (x : CategoryTheory.coyoneda.obj (Opposite.op X) ≅ F),
  (fun r => CategoryTheory.NatIso.ofComponents (fun x => r.homEquiv.toIso) ⋯)
      ((fun e => CategoryTheory.Functor.CorepresentableBy.mk (fun {Y} => (e.app Y).toEquiv) ⋯) x) =
    (fun r => CategoryTheory.NatIso.ofComponents (fun x => r.homEquiv.toIso) ⋯)
      ((fun e => CategoryTheory.Functor.CorepresentableBy.mk (fun {Y} => (e.app Y).toEquiv) ⋯) x)
#[propext, Quot.sound]

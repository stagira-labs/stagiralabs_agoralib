theorem
CategoryTheory.yonedaEquiv_symm_naturality_left
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {X X' : C} (f : X' ⟶ X)
  (F : CategoryTheory.Functor Cᵒᵖ (Type v₁)) (x : F.obj (Opposite.op X)),
  CategoryTheory.CategoryStruct.comp (CategoryTheory.yoneda.map f) (CategoryTheory.yonedaEquiv.symm x) =
    CategoryTheory.yonedaEquiv.symm (F.map f.op x)
#[propext, Quot.sound]

theorem
CategoryTheory.Functor.CorepresentableBy.ext_iff
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {F : CategoryTheory.Functor C (Type v)} {X : C}
  {e e' : F.CorepresentableBy X},
  e = e' ↔ e.homEquiv (CategoryTheory.CategoryStruct.id X) = e'.homEquiv (CategoryTheory.CategoryStruct.id X)
#[propext, Quot.sound]
---
theorem
CategoryTheory.Functor.RepresentableBy.homEquiv_comp
∀ {C : Type u₁} [inst : CategoryTheory.Category.{v₁, u₁} C] {F : CategoryTheory.Functor Cᵒᵖ (Type v)} {Y : C}
  (self : F.RepresentableBy Y) {X X' : C} (f : X ⟶ X') (g : X' ⟶ Y),
  self.homEquiv (CategoryTheory.CategoryStruct.comp f g) = F.map f.op (self.homEquiv g)
#[propext, Quot.sound]
